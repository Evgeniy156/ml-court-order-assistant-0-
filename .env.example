# ============================================
# РџСЂРёРјРµСЂ С„Р°Р№Р»Р° РїРµСЂРµРјРµРЅРЅС‹С… РѕРєСЂСѓР¶РµРЅРёСЏ
# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё Р·Р°РїРѕР»РЅРёС‚Рµ Р·РЅР°С‡РµРЅРёСЏ
# ============================================

# Telegram Bot
# РџРѕР»СѓС‡РёС‚Рµ С‚РѕРєРµРЅ Сѓ @BotFather РІ Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Database
# Р”Р»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё (SQLite):
DATABASE_URL=sqlite:///./dev.db

# Р”Р»СЏ Docker/PostgreSQL:
# DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@database:5432/ml_court

# PostgreSQL credentials (РґР»СЏ Docker)
POSTGRES_DB=ml_court
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_PASSWORD

# JWT Secret Key
# Р’РђР–РќРћ: РР·РјРµРЅРёС‚Рµ РЅР° СЃР»СѓС‡Р°Р№РЅСѓСЋ СЃС‚СЂРѕРєСѓ РІ РїСЂРѕРґР°РєС€РµРЅРµ!
SECRET_KEY=REPLACE_ME_WITH_SECURE_RANDOM_STRING

# RabbitMQ (РґР»СЏ Docker)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=REPLACE_PASSWORD
RABBITMQ_QUEUE=ml_tasks

# RabbitMQ (РґР»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
